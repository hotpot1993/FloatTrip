# 高德 Web 服务 Key（必填）
AMAP_API_KEY=

# 高德 Web端(JS API) Key（前端地图用，可选）
AMAP_JS_KEY=

# 高德 JS API 安全密钥 securityJsCode（与 JS Key 配套，可选）
AMAP_JS_SECURITY_CODE=

# LLM 提供商（可选，默认 "deepseek"，支持 "deepseek"、"doubao"）
# LLM_PROVIDER=deepseek

# DeepSeek API Key（如果使用 DeepSeek 提供商，此项必填）
DEEPSEEK_API_KEY=

# DeepSeek 模型（可选，默认 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-flash

# 豆包 API Key（如果使用豆包提供商，此项必填）
# DOUBAO_API_KEY=

# 豆包模型（可选，默认 doubao-pro-4k）
# DOUBAO_MODEL=doubao-pro-4k

# Redis 缓存（可选，不配置则禁用缓存）
REDIS_URL=redis://localhost:6379/0

# ─── 高德配额保护 ──────────────────────────────────────────────
#
# 高德自 2025-05-20 起取消日配额，改为按「服务组」共享的月配额：
#   https://lbs.amap.com/news/service_amap
# 同一服务组内所有接口、同一账号下所有 Key（含 JS API Key）合计消耗同一份额度。
# 已认证个人开发者的官方额度（https://lbs.amap.com/upgrade#price）：
#
#   基础搜索服务（关键字查询 + 周边查询）  5,000 / 月
#   其它基础服务-天气预报（天气查询）      5,000 / 月
#   基础LBS服务（步行路径规划等）        150,000 / 月
#
# 下面的默认值取官方数值的 95%，留 5% 安全边际：官方未说明「被高德拒绝的请求
# 是否计入配额消耗」，边际用来覆盖这个不确定性。
#
# 0 表示不限制。**额度不足时程序会直接拒绝请求、一次都不发出**，所以限额调得过低
# 会让规划直接不可用；调高则失去保护。
#
# 高德没有配额查询接口（只能登录控制台「流量分析 → 配额管理」查看），因此本地
# 计数从部署那刻起从 0 开始，看不到部署前的消耗。用这个接口录入控制台读数对账：
#   POST /api/runtime/amap-quota/reconcile   {"bucket": "search", "used": 1234}
# bucket 取值：search | weather | lbs

# 基础搜索服务月配额（官方 5000）
# AMAP_QUOTA_SEARCH_LIMIT=4750

# 天气预报月配额（官方 5000）
# AMAP_QUOTA_WEATHER_LIMIT=4750

# 基础LBS服务月配额（官方 150000）。默认 0 = 不限制：
# 该池的主流消耗者是前端的 AMap.Driving，服务端数不到；后端只有步行路线一个
# 出口且额度充裕，设一个拦不住大头的假上限只会给出虚假的安全感。
# AMAP_QUOTA_LBS_LIMIT=0

# 预警阈值比例（达到限额的 80% 时提示一次，不拦截调用）
# AMAP_QUOTA_WARNING_RATIO=0.8

# Agent Runtime 并发与 checkpoint（均可选，以下为默认值）
# RUNTIME_CHAT_CONCURRENCY=8
# RUNTIME_PLANNING_CONCURRENCY=2
# RUNTIME_PLANNING_PER_USER=2
# RUNTIME_LLM_CONCURRENCY=8
# RUNTIME_AMAP_CONCURRENCY=8   ← 只约束异步高德调用；生效点在 app/core/async_resources.py
# RUNTIME_CHECKPOINT_DB=data/langgraph-checkpoints.db

# Chat 会话记忆、压缩与提取（均可选，以下为默认值）
# CHAT_CONTEXT_BUDGET_TOKENS=3000
# CHAT_SUMMARY_TRIGGER_TOKENS=2600
# CHAT_SUMMARY_TARGET_TOKENS=600
# CHAT_RECENT_TURNS=6
# CHAT_MAX_MESSAGE_TOKENS=1200
# CHAT_SUMMARY_MODEL=
# MEMORY_EXTRACTION_MODEL=
# MEMORY_EXTRACTION_INPUT_TOKENS=6000
# PLANNING_MEMORY_MATCH_MODEL=

# HTTP 代理（可选）
# HTTPS_PROXY=http://127.0.0.1:7890

# LangSmith 追踪（可选，接入后可在 smith.langchain.com 查看 Agent 链路）
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__你的key
# LANGCHAIN_PROJECT=floattrip-dev
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
